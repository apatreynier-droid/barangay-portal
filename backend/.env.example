DB_HOST=localhost
DB_PORT=3306
DB_NAME=barangay_portal
DB_USER=barangay_app
DB_PASSWORD=your_password_here

SECRET_KEY=your_secret_key_here

# --- Login rate limiting (all optional; defaults shown) ---------------------
# Max consecutive failed login attempts before login is blocked (per IP+account)
LOGIN_MAX_FAILED_ATTEMPTS=5
# Failed attempts older than this many seconds are forgotten (sliding window)
LOGIN_FAILURE_WINDOW_SECONDS=300
# How long login stays blocked after too many consecutive failed attempts
LOGIN_BLOCK_DURATION_SECONDS=900
# Per-IP flood protection: max login requests per IP...
LOGIN_IP_MAX_REQUESTS=10
# ...within this many seconds
LOGIN_IP_WINDOW_SECONDS=60

# --- SMTP email delivery (Forgot Password, request status, registration) -----
# Values only live in backend/.env; never commit real credentials.
# Gmail: use smtp.gmail.com with a Google App Password (Google Account >
# Security > 2-Step Verification > App passwords), not the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_gmail_address
SMTP_PASSWORD=your_google_app_password
# Address emails are sent from (SMTP_FROM is also accepted; defaults to
# SMTP_USERNAME when both are empty)
SMTP_FROM_EMAIL=your_gmail_address
# STARTTLS for port 587/25; port 465 always uses implicit SSL
SMTP_USE_TLS=true
# Friendly sender name shown in mail clients
SMTP_FROM_NAME=Barangay Lagab Document Portal
# Give up on an unreachable SMTP server after this many seconds
SMTP_TIMEOUT_SECONDS=15

# --- Password reset flow ----------------------------------------------------
# Base URL of the React app (reset links and the approval email's login link
# are built from it). Set it to the public portal address in production.
FRONTEND_URL=http://localhost:5173
# Minutes a reset link stays valid
PASSWORD_RESET_TOKEN_EXPIRATION_MINUTES=15
# Reset emails allowed per client IP (sliding window)
PASSWORD_RESET_IP_MAX_REQUESTS=5
PASSWORD_RESET_IP_WINDOW_SECONDS=900
# Reset emails allowed per target address (sliding window)
PASSWORD_RESET_EMAIL_MAX_REQUESTS=3
PASSWORD_RESET_EMAIL_WINDOW_SECONDS=900
# Reset submissions (token exchange) allowed per client IP
PASSWORD_RESET_SUBMIT_MAX_REQUESTS=20
PASSWORD_RESET_SUBMIT_WINDOW_SECONDS=900

# --- Resident registration (all optional; defaults shown) --------------------
# Registrations allowed per client IP (sliding window)
REGISTRATION_IP_MAX_REQUESTS=20
REGISTRATION_IP_WINDOW_SECONDS=3600
# Seconds between automatic retries of failed registration emails (0 = off)
REGISTRATION_EMAIL_WORKER_INTERVAL_SECONDS=60
# Automatic attempts per email before it waits for an administrator's retry
REGISTRATION_EMAIL_MAX_ATTEMPTS=6

# --- Uploaded images (all optional; defaults shown) ---------------------------
# Persistent folder for resident uploads (document request attachments and
# pothole report photos). Files are only served through authenticated endpoints.
# UPLOAD_DIR=C:\path\to\backend\uploads
# Largest pothole report photo accepted, in bytes (10 MB)
POTHOLE_PHOTO_MAX_BYTES=10485760
