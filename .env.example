# Frontend environment (Vite). Copy the lines you need into one of:
#   .env.local         - this computer only (git-ignored)    -> npm run dev
#   .env.production    - used by `npm run build`             -> production
# Only variables starting with VITE_ are sent to the browser. Never put
# secrets (passwords, API keys, private keys) in a VITE_ variable.

# --- API address (src/Utils/Shared/api.ts) ----------------------------------
# Leave EMPTY in local development: the app then calls the API on the same
# protocol + host that served the page, port 8000. So
#   https://localhost:5173      -> https://localhost:8000
#   https://192.168.1.25:5173   -> https://192.168.1.25:8000   (phone on Wi-Fi)
# Set it only when the API lives somewhere else, e.g. in production:
#   VITE_API_BASE_URL=https://portal.example.com     (Nginx/Caddy forwards /api)
#   VITE_API_BASE_URL=https://api.example.com        (separate API subdomain)
VITE_API_BASE_URL=

# --- Local HTTPS certificate for the dev server (vite.config.ts) -------------
# Not sent to the browser. Defaults shown; paths are relative to this folder.
# DEV_SSL_CERT=certs/localhost.pem
# DEV_SSL_KEY=certs/localhost-key.pem
